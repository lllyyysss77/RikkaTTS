{
  "name": "rikka-tts-client",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "run-p dev:vite dev:server",
    "dev:vite": "vite",
    "dev:server": "nodemon --exec ts-node server.ts",
    "build": "tsc && vite build",
    "start": "node --experimental-specifier-resolution=node --loader ts-node/esm server.ts || ts-node server.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "lucide-react": "^0.344.0",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.18.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.2.1",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "tailwind-scrollbar-hide": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
